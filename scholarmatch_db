/* ======================================
   8. VIEW STUDENT PROFILE
====================================== */
SELECT u.name, sp.*
FROM student_profile sp
JOIN users u ON u.user_id = sp.user_id;

/* ======================================
   9. ELIGIBLE SCHOLARSHIPS QUERY
   (RULE-BASED MATCHING)
====================================== */
SELECT DISTINCT s.scholarship_id, s.title, s.description, s.deadline
FROM scholarships s
JOIN eligibility_rules er ON s.scholarship_id = er.scholarship_id
JOIN student_profile sp ON sp.user_id = 1
WHERE s.status = 'active'
AND (
    (er.field_name = 'marks' AND sp.marks >= er.value) OR
    (er.field_name = 'family_income' AND sp.family_income <= er.value) OR
    (er.field_name = 'category' AND sp.category = er.value) OR
    (er.field_name = 'minority_status' AND sp.minority_status = er.value)
);
