/* ======================================
   12. ELIGIBILITY MATCHING QUERY
   Use this in your PHP for a given user_id
   It uses AND logic: student must pass ALL
   rules for a scholarship to be eligible
====================================== */

-- Apply schema corrections and updates
ALTER TABLE student_profile
DROP COLUMN IF EXISTS state;

CREATE TABLE IF NOT EXISTS states (
  state_id INT AUTO_INCREMENT PRIMARY KEY,
  state_name VARCHAR(100) NOT NULL
);

ALTER TABLE student_profile
ADD COLUMN IF NOT EXISTS disability_type VARCHAR(100) AFTER disability_percent,
ADD COLUMN IF NOT EXISTS parent_name VARCHAR(100) AFTER age,
ADD COLUMN IF NOT EXISTS parent_occupation VARCHAR(100) AFTER parent_name,
ADD COLUMN IF NOT EXISTS parent_contact VARCHAR(15) AFTER parent_occupation,
ADD COLUMN IF NOT EXISTS postgrad_course_other VARCHAR(100) AFTER course,
ADD COLUMN IF NOT EXISTS phd_course_other VARCHAR(100) AFTER postgrad_course_other;

ALTER TABLE eligibility_rules
MODIFY field_name ENUM(
  'marks',
  'family_income',
  'category',
  'gender',
  'state_id',
  'education_level',
  'institution_type',
  'minority_status',
  'disability_percent',
  'age',
  'course'
);

ALTER TABLE eligibility_rules
ADD COLUMN IF NOT EXISTS scholarship_title VARCHAR(150) NOT NULL AFTER scholarship_id;

ALTER TABLE student_profile
ADD COLUMN IF NOT EXISTS full_name VARCHAR(100) NOT NULL AFTER user_id;

-- Eligibility matching query
-- Replace user_id=1 with actual current user_id
SELECT s.scholarship_id, s.title, s.description, s.deadline
FROM scholarships s
WHERE s.status = 'active'
AND (
    SELECT COUNT(*)
    FROM eligibility_rules er
    WHERE er.scholarship_id = s.scholarship_id
) = (
    SELECT COUNT(*)
    FROM eligibility_rules er
    JOIN student_profile sp ON sp.user_id = 1
    WHERE er.scholarship_id = s.scholarship_id
    AND (
        (er.field_name = 'marks'           AND er.operator = '>=' AND sp.marks           >= CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'marks'           AND er.operator = '<=' AND sp.marks           <= CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'marks'           AND er.operator = '>'  AND sp.marks           >  CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'marks'           AND er.operator = '<'  AND sp.marks           <  CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'family_income'   AND er.operator = '>=' AND sp.family_income   >= CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'family_income'   AND er.operator = '<=' AND sp.family_income   <= CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'family_income'   AND er.operator = '='  AND sp.family_income    = CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'age'             AND er.operator = '>=' AND sp.age             >= CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'age'             AND er.operator = '<=' AND sp.age             <= CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'disability_percent' AND er.operator = '>=' AND sp.disability_percent >= CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'category'        AND er.operator = '='  AND sp.category        = er.value) OR
        (er.field_name = 'category'        AND er.operator = 'IN' AND FIND_IN_SET(sp.category, er.value) > 0) OR
        (er.field_name = 'gender'          AND er.operator = '='  AND sp.gender          = er.value) OR
        (er.field_name = 'state_id'        AND er.operator = '='  AND sp.state_id        = CAST(er.value AS UNSIGNED)) OR
        (er.field_name = 'education_level' AND er.operator = '='  AND sp.education_level = er.value) OR
        (er.field_name = 'institution_type'AND er.operator = '='  AND sp.institution_type= er.value) OR
        (er.field_name = 'minority_status' AND er.operator = '='  AND sp.minority_status = er.value)
    )
);
