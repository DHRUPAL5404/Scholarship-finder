/* ======================================
   SCHOLARMATCH DATABASE - UPDATED
   Improvements:
   - Removed duplicate ALTER TABLE calls
   - Clean table creation order (no patching needed)
   - Hashed sample passwords (use PHP password_hash() in app)
   - Added indexes for faster eligibility queries
   - Fixed eligibility matching query (AND logic)
   - Added scholarship_applications table
   - Removed redundant scholarship_title from eligibility_rules
   - Sample data uses subqueries instead of hardcoded IDs
     (no more foreign key errors if IDs shift)
====================================== */

/* ======================================
   1. CREATE & USE DATABASE
====================================== */
CREATE DATABASE IF NOT EXISTS scholarmatch_db
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;
USE scholarmatch_db;

/* ======================================
   2. DROP EXISTING TABLES (ORDER MATTERS)
====================================== */
DROP TABLE IF EXISTS scholarship_applications;
DROP TABLE IF EXISTS eligibility_rules;
DROP TABLE IF EXISTS scholarships;
DROP TABLE IF EXISTS student_profile;
DROP TABLE IF EXISTS sub_districts;
DROP TABLE IF EXISTS districts;
DROP TABLE IF EXISTS states;
DROP TABLE IF EXISTS users;

/* ======================================
   3. USERS TABLE
====================================== */
CREATE TABLE users (
    user_id   INT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    email     VARCHAR(100) UNIQUE NOT NULL,
    mobile    VARCHAR(15)  UNIQUE,
    password  VARCHAR(255) NOT NULL,
    role      ENUM('student','admin') DEFAULT 'student',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

/* ======================================
   4. LOCATION TABLES
====================================== */
CREATE TABLE states (
    state_id   INT AUTO_INCREMENT PRIMARY KEY,
    state_name VARCHAR(100) NOT NULL
);

CREATE TABLE districts (
    district_id   INT AUTO_INCREMENT PRIMARY KEY,
    district_name VARCHAR(100) NOT NULL,
    state_id      INT NOT NULL,
    FOREIGN KEY (state_id) REFERENCES states(state_id) ON DELETE CASCADE
);

CREATE TABLE sub_districts (
    sub_district_id   INT AUTO_INCREMENT PRIMARY KEY,
    sub_district_name VARCHAR(100) NOT NULL,
    district_id       INT NOT NULL,
    FOREIGN KEY (district_id) REFERENCES districts(district_id) ON DELETE CASCADE
);

/* ======================================
   5. STUDENT PROFILE TABLE
====================================== */
CREATE TABLE student_profile (
    profile_id             INT AUTO_INCREMENT PRIMARY KEY,
    user_id                INT UNIQUE NOT NULL,
    full_name              VARCHAR(100) NOT NULL,
    gender                 ENUM('Male','Female','Other') NOT NULL,
    age                    INT NOT NULL,
    state_id               INT,
    district_id            INT,
    sub_district_id        INT,
    education_level        VARCHAR(50) NOT NULL,
    course                 VARCHAR(100) NOT NULL,
    postgrad_course_other  VARCHAR(100),
    phd_course_other       VARCHAR(100),
    current_year           VARCHAR(20) NOT NULL,
    marks                  INT NOT NULL,
    family_income          INT NOT NULL,
    category               VARCHAR(20) NOT NULL,
    minority_status        ENUM('Yes','No') NOT NULL,
    institution_type       VARCHAR(50) NOT NULL,
    disability_percent     INT NOT NULL DEFAULT 0,
    disability_type        VARCHAR(100),
    parent_name            VARCHAR(100),
    parent_occupation      VARCHAR(100),
    parent_contact         VARCHAR(15),
    FOREIGN KEY (user_id)         REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (state_id)        REFERENCES states(state_id),
    FOREIGN KEY (district_id)     REFERENCES districts(district_id),
    INDEX idx_category    (category),
    INDEX idx_marks       (marks),
    INDEX idx_income      (family_income),
    INDEX idx_state       (state_id)
);

/* ======================================
   6. SCHOLARSHIPS TABLE
====================================== */
CREATE TABLE scholarships (
    scholarship_id INT AUTO_INCREMENT PRIMARY KEY,
    title          VARCHAR(150) NOT NULL,
    description    TEXT,
    deadline       DATE,
    status         ENUM('active','inactive') DEFAULT 'active',
    created_at     DATETIME DEFAULT CURRENT_TIMESTAMP
);

/* ======================================
   7. ELIGIBILITY RULES TABLE
====================================== */
CREATE TABLE eligibility_rules (
    rule_id        INT AUTO_INCREMENT PRIMARY KEY,
    scholarship_id INT NOT NULL,
    field_name     ENUM(
                       'marks',
                       'family_income',
                       'category',
                       'gender',
                       'state_id',
                       'education_level',
                       'institution_type',
                       'minority_status',
                       'disability_percent',
                       'age'
                   ) NOT NULL,
    operator       ENUM('=','>=','<=','>','<','IN') NOT NULL,
    value          VARCHAR(255) NOT NULL,
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id) ON DELETE CASCADE,
    INDEX idx_scholarship (scholarship_id)
);

/* ======================================
   8. SCHOLARSHIP APPLICATIONS TABLE
====================================== */
CREATE TABLE scholarship_applications (
    application_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id        INT NOT NULL,
    scholarship_id INT NOT NULL,
    status         ENUM('pending','approved','rejected') DEFAULT 'pending',
    applied_at     DATETIME DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY unique_application (user_id, scholarship_id),
    FOREIGN KEY (user_id)        REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id) ON DELETE CASCADE
);

