/* ======================================
   1. CREATE & USE DATABASE
====================================== */
CREATE DATABASE IF NOT EXISTS scholarmatch_db;
USE scholarmatch_db;

/* ======================================
   2. DROP EXISTING TABLES (ORDER MATTERS)
====================================== */
DROP TABLE IF EXISTS eligibility_rules;
DROP TABLE IF EXISTS scholarships;
DROP TABLE IF EXISTS student_profile;
DROP TABLE IF EXISTS users;

/* ======================================
   3. USERS TABLE
====================================== */
CREATE TABLE users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    role ENUM('student','admin') DEFAULT 'student'
);

/* ======================================
   4. STUDENT PROFILE TABLE
====================================== */
CREATE TABLE student_profile (
    profile_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT UNIQUE NOT NULL,
    education_level VARCHAR(50) NOT NULL,
    course VARCHAR(100) NOT NULL,
    current_year VARCHAR(20) NOT NULL,
    marks INT NOT NULL,
    family_income INT NOT NULL,
    category VARCHAR(20) NOT NULL,
    gender ENUM('Male','Female','Other') NOT NULL,
    state VARCHAR(50) NOT NULL,
    institution_type VARCHAR(50) NOT NULL,
    age INT NOT NULL,
    disability_percent INT NOT NULL,
    minority_status ENUM('Yes','No') NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(user_id)
);

/* ======================================
   5. SCHOLARSHIPS TABLE
====================================== */
CREATE TABLE scholarships (
    scholarship_id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(150) NOT NULL,
    description TEXT,
    deadline DATE,
    status ENUM('active','inactive') DEFAULT 'active'
);

/* ======================================
   6. ELIGIBILITY RULES TABLE
====================================== */
CREATE TABLE eligibility_rules (
    rule_id INT AUTO_INCREMENT PRIMARY KEY,
    scholarship_id INT NOT NULL,
    field_name ENUM(
        'marks',
        'family_income',
        'category',
        'gender',
        'state',
        'education_level',
        'institution_type',
        'minority_status',
        'disability_percent',
        'age'
    ) NOT NULL,
    operator ENUM('=','>=','<=','>','<') NOT NULL,
    value VARCHAR(100) NOT NULL,
    FOREIGN KEY (scholarship_id)
        REFERENCES scholarships(scholarship_id)
        ON DELETE CASCADE
);

